# Copy to `.env.local` for local development. Never commit real secrets.
# Each variable is added here in the phase that first needs it.

# PostgreSQL — matches the defaults in docker-compose.yml. Used from Phase 2.
DATABASE_URL="postgresql://sms:sms_local_only@localhost:5432/sms_associates"

# Optional: the server integration tests use (they create and drop sms_test_* databases on it,
# so the role needs CREATEDB). Defaults to DATABASE_URL.
# TEST_DATABASE_URL="postgresql://sms:sms_local_only@localhost:5432/sms_associates"

# Auth (Phase 3). The secret signs session cookies: generate your own with
#   openssl rand -base64 32
# and use a different one in every environment. At least 32 characters.
BETTER_AUTH_SECRET=""
# The address the app is opened at (https:// in production).
BETTER_AUTH_URL="http://localhost:3000"

# Optional: private folder for customer documents (outside public/). Default: storage/documents
# DOCUMENTS_DIR="storage/documents"
