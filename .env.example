# Copy to `.env.local` for local development. Never commit real secrets.
# Each variable is added here in the phase that first needs it.

# PostgreSQL — matches the defaults in docker-compose.yml. Used from Phase 2.
DATABASE_URL="postgresql://sms:sms_local_only@localhost:5432/sms_associates"

# Optional: the server integration tests use (they create and drop sms_test_* databases on it,
# so the role needs CREATEDB). Defaults to DATABASE_URL.
# TEST_DATABASE_URL="postgresql://sms:sms_local_only@localhost:5432/sms_associates"
